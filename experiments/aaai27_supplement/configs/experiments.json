        "fixed",
        "--model_name",
        "deepseek-v4.1-flash-1017",
        "--optimizer_model",
        "deepseek-v4.1-flash-1017",
        "--protect_model",
        "deepseek-v4.1-flash-1017",
        "--max_rounds",
        "{max_rounds}",
        "--limit",
        "{limit}",
        "--output",
        "{repo_root}/results/aaai27_supplement/table3/fixed_deepseek-v4.1-flash-1017.jsonl"
      ]
    },
    {
      "id": "t3_attack_only_deepseek_41017",
      "table": "T3",
      "enabled": false,
      "description": "Attack-only optimization.",
      "cwd": "{injecagent_root}",
      "command": [
        "{project_python}",
        "{experiment_root}/scripts/run_ablation.py",
        "--mode",
        "attack_only",
        "--model_name",
        "deepseek-v4.1-flash-1017",
        "--optimizer_model",
        "deepseek-v4.1-flash-1017",
        "--protect_model",
        "deepseek-v4.1-flash-1017",
        "--max_rounds",
        "{max_rounds}",
        "--limit",
        "{limit}",
        "--output",
        "{repo_root}/results/aaai27_supplement/table3/attack_only_deepseek-v4.1-flash-1017.jsonl"
      ]
    },
    {
      "id": "t3_defense_only_deepseek_41017",
      "table": "T3",
      "enabled": false,
      "description": "Defense-only optimization.",
      "cwd": "{injecagent_root}",
      "command": [
        "{project_python}",
        "{experiment_root}/scripts/run_ablation.py",
        "--mode",
        "defense_only",
        "--model_name",
        "deepseek-v4.1-flash-1017",
        "--optimizer_model",
        "deepseek-v4.1-flash-1017",
        "--protect_model",
        "deepseek-v4.1-flash-1017",
        "--max_rounds",
        "{max_rounds}",
        "--limit",
        "{limit}",
        "--output",
        "{repo_root}/results/aaai27_supplement/table3/defense_only_deepseek-v4.1-flash-1017.jsonl"
      ]
    },
    {
      "id": "t3_independent_deepseek_41017",
      "table": "T3",
      "enabled": false,
      "description": "Independent attack and defense optimization.",
      "cwd": "{injecagent_root}",
      "command": [
        "{project_python}",
        "{experiment_root}/scripts/run_ablation.py",
        "--mode",
        "independent",
        "--model_name",
        "deepseek-v4.1-flash-1017",
        "--optimizer_model",
        "deepseek-v4.1-flash-1017",
        "--protect_model",
        "deepseek-v4.1-flash-1017",
        "--max_rounds",
        "{max_rounds}",
        "--limit",
        "{limit}",
        "--output",
        "{repo_root}/results/aaai27_supplement/table3/independent_deepseek-v4.1-flash-1017.jsonl"
      ]
    }
  ]
}
